<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0" xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
  <asmv3:application>
    <asmv3:windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <!-- On a machine whose LongPathsEnabled policy is on, the Windows
           calls that stop at 260 characters take longer paths: opening a
           file does, and setting the current directory. Starting a program
           in such a directory still fails, with or without this. On other
           machines it changes nothing.
           https://learn.microsoft.com/en-us/windows/win32/sbscs/application-manifests#longpathaware
           https://learn.microsoft.com/en-us/windows/win32/fileio/maximum-file-path-limitation -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <!-- The process's code page is UTF-8, from Windows 10 1903 on (before
           that the process keeps the system's). A library that opens files
           by their narrow names (FreeType opens fonts so) then reads the
           UTF-8 paths it is given. The programs Ghostty starts are not
           affected: a shell keeps its console's code page.
           https://learn.microsoft.com/en-us/windows/apps/design/globalizing/use-utf8-code-page -->
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
      <!-- No heapType: with the segment heap, start-up, throughput and
           memory measured the same as without it. -->
    </asmv3:windowsSettings>
  </asmv3:application>
  <!-- The Windows versions Ghostty is written for: Windows 10 and 11. The exe
       imports CreatePseudoConsole, so it does not start before Windows 10
       1809, and declaring Windows 8 or 8.1 would claim more than that.
       Windows uses the newest version declared, and Windows 10's includes
       Windows 8's, which lets a child window be layered (WS_EX_LAYERED): a
       transparent window layers its tab bar, search bar and palette so they
       stay opaque. With no supportedOS at all, layering a child fails.
       https://learn.microsoft.com/en-us/windows/win32/sbscs/application-manifests#supportedos -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0" processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*" />
    </dependentAssembly>
  </dependency>
</assembly>
